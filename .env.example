# ================================================================
# Arc Public Testnet 网络节点配置
# ================================================================
# Arc 测试网 RPC 终端节点与网络 ID
ARC_RPC_URL="https://testnet.arc.network"
ARC_CHAIN_ID=50420

# 底层协议原生 Gas 精度 (Arc 底层强制以 18 位表达稳定币 Gas)
ARC_NATIVE_GAS_PRECISION=18

# 标准 ERC-20 USDC 资产合约地址 (资产层 6 位精度)
ARC_USDC_CONTRACT_ADDRESS="0x..."

# ================================================================
# Circle Agentic Commerce & 可编程钱包配置
# ================================================================
# Circle 开发者平台 API 密钥
CIRCLE_API_KEY="your_circle_api_key_here"

# 实体加密密钥 (Entity Secret, 32 字节十六进制字符)
CIRCLE_ENTITY_SECRET="your_entity_secret_hex_here"

# 绑定的 Agent 开发者受控钱包 ID (用于自动调用 Hook 熔断方法)
CIRCLE_AGENT_WALLET_ID="your_agent_wallet_id_here"

# ================================================================
# Uniswap v4 监听目标与 Sentinel Hook
# ================================================================
# Uniswap v4 核心池管理器地址
V4_POOL_MANAGER_ADDRESS="0x..."

# 已部署的 SentinelHook 合约地址 (需带 0x0080 前缀掩码)
SENTINEL_HOOK_ADDRESS="0x..."

# ================================================================
# 哨兵监控引擎风控参数
# ================================================================
# 波动率二阶导数 (曲率) 触发阈值
CURVATURE_THRESHOLD=0.04

# 队列滑动窗口大小 (采样点数量)
SURVEILLANCE_WINDOW_SIZE=10

# 状态轮询时间间隔 (毫秒)
TELEMETRY_INTERVAL_MS=200
